{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*[^#\\s].*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*$"
  },
  "onEnterRules": [
    { "beforeText": "^\\s*[\\w.-]+\\s*:\\s*(#.*)?$", "action": { "indent": "indent" } }
  ],
  "folding": { "offSide": true },
  "wordPattern": "[A-Za-z_][\\w-]*"
}
